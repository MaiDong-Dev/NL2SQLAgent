%% 图1：包级依赖关系图（Package Dependency Graph） - 展示各顶层包的 import 方向
graph TB
    subgraph "入口层"
        API["api<br/>FastAPI 路由 + 依赖注入"]
        SCRIPTS["scripts<br/>命令行脚本入口"]
    end

    subgraph "服务层"
        QS["services/query_service<br/>QueryService<br/>查询入口, 组装Context/State"]
        MKS["services/meta_knowledge_service<br/>MetaKnowledgeService<br/>元知识构建, 同步三大存储"]
    end

    subgraph "Agent 层"
        GRAPH["agent/graph<br/>LangGraph 工作流定义"]
        NODES["agent/nodes/*<br/>13个 Pipeline 节点"]
        STATE["agent/state<br/>DataAgentState"]
        CTX["agent/context<br/>DataAgentContext"]
        LLM["agent/llm<br/>ChatOpenAI 初始化"]
    end

    subgraph "提示词层"
        PROMPT["prompt/prompt_loader<br/>PromptLoader<br/>Jinja2模板加载"]
    end

    subgraph "仓库层"
        META_REPO["repositories/mysql/meta<br/>MetaMySQLRepository"]
        DW_REPO["repositories/mysql/dw<br/>DWMySQLRepository"]
        COL_QDRANT["repositories/qdrant/column<br/>ColumnQdrantRepository"]
        MET_QDRANT["repositories/qdrant/metric<br/>MetricQdrantRepository"]
        VAL_ES["repositories/es/value<br/>ValueESRepository"]
    end

    subgraph "实体层"
        ENTITIES["entities/*<br/>ColumnInfo, TableInfo<br/>MetricInfo, ValueInfo<br/>ColumnMetric"]
    end

    subgraph "模型层"
        MODELS["models/*<br/>ColumnInfoMySQL<br/>TableInfoMySQL<br/>MetricInfoMySQL<br/>ColumnMetricMySQL"]
        BASE["models/base<br/>DeclarativeBase"]
    end

    subgraph "客户端层"
        EMB_CLIENT["clients/embedding<br/>EmbeddingClientManager<br/>HuggingFace TEI"]
        QD_CLIENT["clients/qdrant<br/>QdrantClientManager<br/>AsyncQdrantClient"]
        ES_CLIENT["clients/es<br/>ESClientManager<br/>AsyncElasticsearch"]
        MYSQL_CLIENT["clients/mysql<br/>MysqlClientManager<br/>AsyncSession"]
    end

    subgraph "配置层"
        APP_CONF["conf/app_config<br/>AppConfig<br/>DB/Qdrant/ES/LLM/Embedding"]
        META_CONF["conf/meta_config<br/>MetaConfig<br/>表/字段/指标定义"]
        LOADER["conf/config_loader<br/>OmegaConf 加载器"]
    end

    subgraph "核心层"
        LOG["core/log<br/>loguru 日志"]
        LIFESPAN["core/lifespan<br/>FastAPI 生命周期"]
        REQ_CTX["core/context<br/>request_id ContextVar"]
    end

