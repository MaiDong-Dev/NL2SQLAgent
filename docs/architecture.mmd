graph TB
    subgraph S1["阶段1: 关键词生成"]
        Q["用户查询<br/>统计去年各地区的销售总额"]
        JIEBA["jieba 分词<br/>统计, 去年, 地区, 销售, 总额"]
        LLM_KW["LLM 语义扩展<br/>Prompt: 字段推断专家<br/>年份, 地区名称, 销售金额, 订单总额"]
    end

    Q --> JIEBA
    Q --> LLM_KW

    subgraph S2["阶段2: 向量检索"]
        KW_MERGE["合并关键词<br/>jieba U LLM 取并集"]
        EMB["Embedding 向量化<br/>HuggingFaceEndpointEmbeddings.aembed_documents()"]
        QD_SEARCH["Qdrant 向量检索<br/>ColumnQdrantRepository.search()<br/>Top-5 per keyword<br/>score_threshold=0.1"]
    end

    JIEBA --> KW_MERGE
    LLM_KW --> KW_MERGE
    KW_MERGE --> EMB
    EMB --> QD_SEARCH

    subgraph S3["阶段3: 后处理"]
        DEDUP["去重<br/>dict[column_id] 同字段多条记录只保留一条"]
        RANK["隐式排序<br/>Qdrant score 降序<br/>高相似度字段优先"]
    end

    QD_SEARCH --> DEDUP
    DEDUP --> RANK
    RANK --> RESULT["召回结果 list[ColumnInfo]"]

    classDef stage1 fill:#fff3e0,stroke:#f57c00,stroke-width:2px
    classDef stage2 fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
    classDef stage3 fill:#e8f5e9,stroke:#388e3c,stroke-width:2px

    class Q,JIEBA,LLM_KW stage1
    class KW_MERGE,EMB,QD_SEARCH stage2
    class DEDUP,RANK,RESULT stage3


%% =============================================================================
%% 图8：Embedding 多维度向量化策略
%% 展示每个字段如何生成多条向量记录
%% =============================================================================

graph LR
    subgraph SRC["原始数据 ColumnInfo"]
        CI["字段: order_amount<br/>描述: 订单金额<br/>别名: 销售额, 成交额"]
    end

    subgraph VEC["向量化 4条向量记录"]
        V1["向量1: order_amount<br/>字段名精确匹配"]
        V2["向量2: 订单金额<br/>描述语义匹配"]
        V3["向量3: 销售额<br/>别名1覆盖"]
        V4["向量4: 成交额<br/>别名2覆盖"]
    end

    subgraph QDRANT["Qdrant Collection"]
        QC["data-agent-column<br/>VectorConfig: Cosine距离<br/>尺寸: 1024维"]
    end

    subgraph EFFECT["检索效果"]
        R1["查询 卖了多少钱<br/>匹配 订单金额"]
        R2["查询 成交额排行<br/>匹配 成交额"]
        R3["查询 order_amount统计<br/>匹配 order_amount"]
    end

    CI --> V1
    CI --> V2
    CI --> V3
    CI --> V4
    V1 --> QC
    V2 --> QC
    V3 --> QC
    V4 --> QC
    QC --> R1
    QC --> R2
    QC --> R3

    classDef src fill:#fff3e0,stroke:#f57c00,stroke-width:2px
    classDef vec fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
    classDef qdrant fill:#e8eaf6,stroke:#3949ab,stroke-width:2px
    classDef effect fill:#e8f5e9,stroke:#388e3c,stroke-width:2px

    class CI src
    class V1,V2,V3,V4 vec
    class QC qdrant
    class R1,R2,R3 effect