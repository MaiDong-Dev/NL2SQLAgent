%% 图6：元知识构建流程
%% 展示 startup 时如何将配置同步到三大存储引擎
%% =============================================================================

graph TB
    START_BUILD((启动构建)) --> LOAD_CONF["加载 meta_config.yaml<br/>OmegaConf.to_object()"]

    LOAD_CONF --> CHK_TABLE{"有表配置?"}
    CHK_TABLE -->|是| SAVE_TABLE["保存表/字段到 Meta MySQL<br/>MetaMySQLRepository.save_table_infos()<br/>MetaMySQLRepository.save_column_infos()"]
    CHK_TABLE -->|否| CHK_METRIC

    SAVE_TABLE --> QD_COL["字段向量化到 Qdrant<br/>name/description/alias 各自 Embedding<br/>ColumnQdrantRepository.upsert()"]
    QD_COL --> ES_VAL["字段取值到 Elasticsearch<br/>sync=true 的字段建倒排索引<br/>ValueESRepository.index()"]
    ES_VAL --> CHK_METRIC{"有指标配置?"}

    CHK_METRIC -->|是| SAVE_METRIC["保存指标到 Meta MySQL<br/>MetaMySQLRepository.save_metric_infos()<br/>MetaMySQLRepository.save_column_metrics()"]
    CHK_METRIC -->|否| DONE

    SAVE_METRIC --> QD_METRIC["指标向量化到 Qdrant<br/>name/description/alias 各自 Embedding<br/>MetricQdrantRepository.upsert()"]
    QD_METRIC --> DONE((构建完成))

